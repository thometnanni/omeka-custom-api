ORIGIN=http://localhost:5173
OMEKA_API=https://minjian-danganguan.org/api
# Required to call POST/GET /flush. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FLUSH_SECRET=

# Optional, defaults shown
# PAGE_LIMIT=100              # default page size of /query
# PAGE_MAX_LIMIT=200          # largest accepted ?limit=
# SYNC_INTERVAL=60            # seconds between incremental syncs
# FULL_SYNC_INTERVAL=21600    # seconds between full syncs
# RESPONSE_CACHE_MB=64        # in-memory cache of serialized responses
# MEDIA_CACHE_MB=64           # in-memory cache of item media
# SCRIPT_CACHE_MB=64          # memoized simplified/traditional conversions
# EXPORT_PATH=./export.json   # snapshot on disk, also served by /export
